generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FLEET_MANAGER
  MECHANIC
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  fullName       String
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(DRIVER)
  isActive       Boolean        @default(true)
  driver         Driver?
  notifications Notification[]
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, role])
}

model Driver {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id])
  licenseNumber String               @unique
  licenseExpiry DateTime
  phone         String?
  assignments   VehicleAssignment[]
  trips         Trip[]
  fuelRecords   FuelTransaction[]
  createdAt     DateTime             @default(now())

  @@index([licenseExpiry])
}

model Vehicle {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  plateNumber    String
  make           String
  model          String
  year           Int?
  status         VehicleStatus        @default(ACTIVE)
  odometerKm     Float                @default(0)
  assignments    VehicleAssignment[]
  fuelRecords    FuelTransaction[]
  maintenance    MaintenanceRecord[]
  expenses       Expense[]
  gpsLocations   GPSLocation[]
  trips          Trip[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

model VehicleAssignment {
  id        String    @id @default(cuid())
  vehicleId String
  driverId  String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  driver    Driver    @relation(fields: [driverId], references: [id])
  startAt   DateTime  @default(now())
  endAt     DateTime?
  createdAt DateTime  @default(now())

  @@index([vehicleId, endAt])
  @@index([driverId, endAt])
}

model FuelTransaction {
  id            String    @id @default(cuid())
  vehicleId     String
  driverId      String?
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  driver        Driver?   @relation(fields: [driverId], references: [id])
  liters        Decimal   @db.Decimal(10, 2)
  pricePerLiter Decimal   @db.Decimal(10, 2)
  totalCost     Decimal   @db.Decimal(12, 2)
  odometerKm    Float
  station       String?
  receiptUrl    String?
  transactionAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([vehicleId, transactionAt])
}

model MaintenanceRecord {
  id            String            @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceType   String
  description   String?
  cost          Decimal           @db.Decimal(12, 2)
  odometerKm    Float
  status        MaintenanceStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  completedAt   DateTime?
  nextServiceAt DateTime?
  createdAt     DateTime          @default(now())

  @@index([vehicleId, status])
  @@index([scheduledAt, status])
}

model Expense {
  id         String        @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])
  category   String
  description String?
  amount     Decimal       @db.Decimal(12, 2)
  status     ExpenseStatus @default(PENDING)
  receiptUrl String?
  incurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([vehicleId, incurredAt])
}

model GPSLocation {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  latitude   Float
  longitude  Float
  speedKmh   Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
}

model Trip {
  id          String    @id @default(cuid())
  vehicleId   String
  driverId    String?
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])
  startedAt   DateTime
  endedAt     DateTime?
  distanceKm  Float?
  durationMin Int?
  createdAt   DateTime  @default(now())

  @@index([vehicleId, startedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
